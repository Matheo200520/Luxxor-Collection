# EmailJS is optional. EXPO_PUBLIC_* values are included in the client bundle.
EXPO_PUBLIC_EMAILJS_SERVICE_ID=
EXPO_PUBLIC_EMAILJS_TEMPLATE_ID=
EXPO_PUBLIC_EMAILJS_PUBLIC_KEY=

# Optional values. Do not put confidential secrets in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_EMAILJS_PRIVATE_KEY=
EXPO_PUBLIC_CORREO_TIENDA=
